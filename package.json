{
  "name": "@juslink/agent-center-ui",
  "version": "0.2.0",
  "description": "智链平台 Agent 能力与任务中心，含模拟货物查询工具与运输分析 Skill",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "index.js",
    "demo-data.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "engines": {
    "dsh": "0.2.1-rc.5 || >=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "external": [
        "react"
      ]
    }
  }
}
