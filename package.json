{
  "name": "@juslink/agent-center-ui",
  "version": "0.2.4",
  "description": "智链平台场景专家、已授权 MCP 业务工具与个人工作方法",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "index.js",
    "demo-data.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "skill-authoring.js",
    "capability-catalog.js",
    "mock-tools.js",
    "artifact-store.js",
    "gateway-auth.js",
    "subscription-search.js",
    "expert-authoring.js"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "engines": {
    "dsh": "0.2.1-rc.5 || >=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-skill"
      ],
      "external": [
        "react"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "pack:demo": "python3 release/package_release.py"
  }
}
